manifest {
    name            = 'crolllab/genomepanel_nf'
    author          = 'Daniel Croll'
    description     = 'Pipeline to variant call large genome panels'
    version         = '1.0.3'
    nextflowVersion = '>=23.0'
}

workDir = './work'
cleanup = true
process.scratch = false
process.debug = false
process.executor = 'local'
process.cpus = 4



singularity {
    enabled = true
    singularity.autoMounts = true
    envWhitelist = 'APPTAINERENV_NXF_TASK_WORKDIR,SINGULARITYENV_NXF_TASK_WORKDIR'
}

executor {
    submitRateLimit = '120/1min'  
    queueSize = 300
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}


profiles {
    slurm {
        process.executor    = "slurm"
        process.cpus         = 8
    }
    local {
        process.executor    = "local"
        process.cpus         = 4
    }
    local_highCPU {
        process.executor    = "local"
        process.cpus         = 16
    }
}

process {
    withName:SRAresolve {
        container = './singularity/entrez-direct:24.0--he881be0_0'
    }
    withName:SRAdownloadPE {
        container = './singularity/sra-tools%3A3.4.1--h4304569_0'
        maxForks = 10
    }
    withName:SRAdownloadSE {
        container = './singularity/sra-tools%3A3.4.1--h4304569_0'
        maxForks = 10
    }
    withName:trimSequencesSE {
        container = './singularity/fastp%3A1.3.1--h43da1c4_0'
        maxForks = 20
   }
    withName:trimSequencesPE {
        container = './singularity/fastp%3A1.3.1--h43da1c4_0'
        maxForks = 20
   }
    withName:bwaIndex {
        container = './singularity/bwa-mem2%3A2.3--he70b90d_0'
   }
      withName:fastaIndex {
        container = './singularity/samtools%3A1.23.1--ha83d96e_0'
   }
    withName:gatkIndex {
        container = './singularity/picard%3A3.4.0--hdfd78af_0'
   }
    withName:bwaMap {
        container = './singularity/bwa-mem2%3A2.3--he70b90d_0'
   }
    withName:samtoolsSort {
        container = './singularity/samtools%3A1.23.1--ha83d96e_0'
   }
   withName:addRG {
        container = './singularity/picard%3A3.4.0--hdfd78af_0'
   }
    withName:dupRemoval {
        container = './singularity/picard%3A3.4.0--hdfd78af_0'
    }
    withName:GATKHC {
        container = './singularity/gatk4-spark%3A4.6.2.0--hdfd78af_1'
        maxForks = 150
    }
    withName:CombineGVCFs {
        container = './singularity/gatk4-spark%3A4.6.2.0--hdfd78af_1'
   }
    withName:GenotypeGVCFs {
        container = './singularity/gatk4-spark%3A4.6.2.0--hdfd78af_1'
   }
    withName:FilterVCFs {
        container = './singularity/gatk4-spark%3A4.6.2.0--hdfd78af_1'
   }
    withName:CleanVCFs {
        container = './singularity/gatk4-spark%3A4.6.2.0--hdfd78af_1'
       }
    withName:ConcatVCFs {
        container = './singularity/bcftools%3A1.23.1--hb2cee57_0'
       }
    withName:ConcatCleanVCFs {
        container = './singularity/bcftools%3A1.23.1--hb2cee57_0'
       }
    withName:RQualPlotting {
        container = './singularity/r-tidyverse%3A1.2.1'
       }
    withName:PopGenVCF {
        container = './singularity/vcftools%3A0.1.17--pl5321h077b44d_0'
       }
    withName:RSummarizingBWA {
        container = './singularity/r-tidyverse%3A1.2.1'
       }
    withName:RSummarizingFASTP {
        container = './singularity/r-tidyverse%3A1.2.1'
        }
    withName:PipelineStatistics {
        // Uses basic bash utilities (stat, find, awk) - no special container needed
        // But we need a container for Singularity mode, so use samtools (has bash)
        container = './singularity/samtools%3A1.23.1--ha83d96e_0'
        }
    withName:filterReference {
        // Uses Python3 for FASTA parsing
        container = './singularity/gatk4-spark%3A4.6.2.0--hdfd78af_1'
        }
}

